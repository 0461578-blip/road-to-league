[application]

config/name="Road to the League"
run/main_scene="res://main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.05,0.09,0.07,1)

[input]

move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
throw_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
catch_ball={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":67)]}
switch_wr={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
snap_play={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
play_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":49)]}
play_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":50)]}
